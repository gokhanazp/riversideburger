{
  "expo": {
    "name": "Riverside Burgers",
    "slug": "riverside-burgers",
    "scheme": "riversideburgers",
    "version": "2.0.9",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "runtimeVersion": "2.0.9",
    "updates": {
      "url": "https://u.expo.dev/8fe95f1d-8d84-4ccf-8b75-cdd48aceb0fd",
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.riverside-burgers.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Riverside Burgers does not use the camera. A third-party library references the API, so Apple requires this notice.",
        "NSBluetoothAlwaysUsageDescription": "Riverside Burgers connects to the restaurant's Bluetooth receipt printer to print order tickets. Used by staff only.",
        "NSBluetoothPeripheralUsageDescription": "Riverside Burgers connects to the restaurant's Bluetooth receipt printer to print order tickets. Used by staff only."
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.riverside_burgers.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E63946"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "USE_FULL_SCREEN_INTENT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#E63946",
          "sounds": [
            "./assets/order_sound.mp3"
          ],
          "mode": "production"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Sipariş takibi sırasında yakındaki kuryeyi göstermek için konumunuza erişiyoruz."
        }
      ],
      "@maplibre/maplibre-react-native",
      "./plugins/withEscPosPrinter",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.riversideburgers",
          "enableGooglePay": true
        }
      ],
      [
        "@react-native-firebase/app",
        {
          "ios": {
            "disableSPM": true
          }
        }
      ],
      "@react-native-firebase/analytics",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8fe95f1d-8d84-4ccf-8b75-cdd48aceb0fd"
      },
      "supabaseUrl": "https://srcslhltajjvteqeptrt.supabase.co",
